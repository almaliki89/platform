+export interface MatterProperties {
+  state: MatterState;
+  stateAr: string;
+  shapeAr: string;
+  volumeAr: string;
+  intermolecularDistanceAr: string;
+  cohesiveForceAr: string;
+  kineticEnergyLevelAr: string;
+  particleSpeedMultiplier: number;
+  vibrationRadius: number;
+}
