rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all to prevent unmapped collection access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Hardened path and ID validator
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check student document ownership
    function isOwner(studentId) {
      return isAuthenticated() && isValidId(studentId) && (request.auth.uid == studentId);
    }

    // Student profile, settings and overall progress (strict owner-only privacy)
    match /students/{studentId} {
      allow read: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(studentId) && request.resource.data.uid == request.auth.uid;
      allow delete: if false;

      // Student sub-collections: exam results
      match /exam_results/{resultId} {
        allow read: if isOwner(studentId);
        allow create, update: if isOwner(studentId) && isValidId(resultId);
        allow delete: if false;
      }

      // Student sub-collections: notes
      match /notes/{noteId} {
        allow read: if isOwner(studentId);
        allow create, update, delete: if isOwner(studentId) && isValidId(noteId);
      }

      // Student sub-collections: bookmarks
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(studentId);
        allow create, update, delete: if isOwner(studentId) && isValidId(bookmarkId);
      }
    }

    // Global leaderboards / public statistics (read-only for clients, writes secured)
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }

    // Shared curriculum or malzama drafts (read-only for clients, writes secured)
    match /curriculum_shared/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
