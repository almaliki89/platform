rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check student document ownership
    function isOwner(studentId) {
      return isAuthenticated() && (request.auth.uid == studentId);
    }

    // Student profile, settings and overall progress
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(studentId);
      allow delete: if false;

      // Student sub-collections: exam results
      match /exam_results/{resultId} {
        allow read, write: if isOwner(studentId);
      }

      // Student sub-collections: notes
      match /notes/{noteId} {
        allow read, write: if isOwner(studentId);
      }

      // Student sub-collections: bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(studentId);
      }
    }

    // Global leaderboards / public statistics
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Shared curriculum or malzama drafts if stored centrally
    match /curriculum_shared/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
