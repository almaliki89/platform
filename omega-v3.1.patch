+import { Quiz } from './curriculum';
+
+export interface ExtractedRuleDraft {
+  title: string;
+  formula: string;
+  explanation: string;
+  examples: string[];
+  unitHint?: string;
+}
+
+export interface ExtractedVocabDraft {
+  word: string;
